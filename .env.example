# ============================================================
# AI Front Desk SaaS — Environment Variables Example
# Copy this to .env.local and fill in the values.
# NEVER commit real credentials to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Front Desk"

# ------------------------------------------------------------
# Supabase (https://supabase.com)
# These are safe to expose to the browser (anon key is limited by RLS)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct DB connection for Prisma migrations (bypass pooler)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Pooled connection for serverless runtime (Supabase Transaction Pooler)
DATABASE_URL_POOLED=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------
# Primary: Google Gemini (https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Fallback: OpenAI (https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# AI provider selection: 'gemini' | 'openai' | 'auto'
AI_PRIMARY_PROVIDER=gemini
# Maximum retries before switching providers
AI_MAX_RETRIES=2

# ------------------------------------------------------------
# WhatsApp Business Platform (Meta)
# https://developers.facebook.com/docs/whatsapp
# ------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
# WhatsApp API version
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------
# Google Calendar OAuth 2.0
# https://console.cloud.google.com
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorized Redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/calendar/callback

# ------------------------------------------------------------
# Payments (Razorpay — Domestic INR & International USD)
# https://dashboard.razorpay.com
# ------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# 32-byte hex string for AES-256 encryption of integration credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Shared secret for internal cron job endpoints
CRON_SECRET=your-random-cron-secret

# Shared secret for administrative initialization endpoint
ADMIN_INIT_SECRET=your-random-admin-init-secret

# NEXTAUTH / Session secret (if adding next-auth later)
# NEXTAUTH_SECRET=your-nextauth-secret

# ------------------------------------------------------------
# Email Notifications (optional — Resend recommended)
# https://resend.com
# ------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------
# Super Admin
# ------------------------------------------------------------
# Email addresses that have super-admin access (comma-separated)
SUPER_ADMIN_EMAILS=admin@yourdomain.com

# ------------------------------------------------------------
# Rate Limiting (defaults, can be overridden in DB config)
# ------------------------------------------------------------
RATE_LIMIT_PER_PHONE_PER_MINUTE=10
RATE_LIMIT_PER_CLINIC_PER_MINUTE=30
RATE_LIMIT_AUTH_FAILURES=10

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_GOOGLE_CALENDAR=true
ENABLE_AI_FALLBACK=true
NEXT_PUBLIC_ENABLE_STATIC_EXPORT=false
